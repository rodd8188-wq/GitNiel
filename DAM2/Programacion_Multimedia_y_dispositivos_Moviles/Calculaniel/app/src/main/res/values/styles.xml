<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ESTILO BASE: lo que comparten TODOS los botones.
         Hereda del botón de Material 3. -->
    <style name="Calculator.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <!-- Quitamos márgenes internos para que el botón ocupe todo su hueco -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- Botones numéricos (0-9 y el punto).
         El nombre "Calculator.Button.Number" indica que hereda de "Calculator.Button". -->
    <style name="Calculator.Button.Number">
        <item name="backgroundTint">@color/button_number_bg</item>
        <item name="android:textColor">@color/button_number_text</item>
    </style>

    <!-- Botones de operadores básicos (+ - × ÷) -->
    <style name="Calculator.Button.Operator">
        <item name="backgroundTint">@color/button_operator_bg</item>
        <item name="android:textColor">@color/button_operator_text</item>
    </style>

    <!-- Botones de acciones especiales (C, DEL, ±) -->
    <style name="Calculator.Button.Special">
        <item name="backgroundTint">@color/button_special_bg</item>
        <item name="android:textColor">@color/button_special_text</item>
    </style>

    <!-- Botón igual (=) -->
    <style name="Calculator.Button.Equals">
        <item name="backgroundTint">@color/button_equals_bg</item>
        <item name="android:textColor">@color/button_equals_text</item>
    </style>

</resources>