<?xml version="1.0" encoding="utf-8"?>
<!-- ConstraintLayout: contenedor principal. Colocamos las vistas
     "atándolas" a los bordes o a otras vistas. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_background"
    android:padding="12dp">

    <!-- Guideline: línea invisible al 28% de la altura.
         Arriba van las pantallas, debajo el teclado. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.28" />

    <!-- PANTALLA SECUNDARIA: muestra la operación en curso (ej: 12.5 + 4) -->
    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/display_secondary_text"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@id/tvResult"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- PANTALLA PRINCIPAL: número actual o resultado.
         autoSizeTextType="uniform" reduce la letra si el número es muy largo. -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="end"
        android:maxLines="1"
        android:text="0"
        android:textColor="@color/display_main_text"
        android:textSize="56sp"
        app:autoSizeMaxTextSize="56sp"
        app:autoSizeMinTextSize="24sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/guidelineDisplay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- TECLADO: GridLayout de 4 columnas x 5 filas.
         Cada botón usa width/height = 0dp + weight = 1 para repartirse el espacio
         a partes iguales (así se adapta a cualquier pantalla). -->
    <GridLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineDisplay">

        <!-- ===== FILA 1: C, ±, DEL, ÷ ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/Calculator.Button.Special"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="C" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSign"
            style="@style/Calculator.Button.Special"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="±" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Calculator.Button.Special"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="DEL" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDivide"
            style="@style/Calculator.Button.Operator"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="÷" />

        <!-- ===== FILA 2: 7, 8, 9, × ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMultiply"
            style="@style/Calculator.Button.Operator"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="×" />

        <!-- ===== FILA 3: 4, 5, 6, - ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubtract"
            style="@style/Calculator.Button.Operator"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="-" />

        <!-- ===== FILA 4: 1, 2, 3, + ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Calculator.Button.Operator"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="+" />

        <!-- ===== FILA 5: 0 (ocupa 2 columnas), ., = ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn0"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDot"
            style="@style/Calculator.Button.Number"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEquals"
            style="@style/Calculator.Button.Equals"
            android:layout_width="0dp" android:layout_height="0dp"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:layout_gravity="fill" android:layout_margin="4dp"
            android:text="=" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>